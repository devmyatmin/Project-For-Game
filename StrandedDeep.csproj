<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net8.0-android</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'ios' ">net8.0-ios</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Keep Unity source folders as reference only; do not compile them into the Godot port. -->
  <ItemGroup>
    <Compile Remove="Player_Controller/**/*.cs" />
    <Compile Remove="Survival_Systems/**/*.cs" />
    <Compile Remove="Inventory_Items/**/*.cs" />
    <Compile Remove="Save_Load/**/*.cs" />
    <Compile Remove="World_Island/**/*.cs" />
  </ItemGroup>
</Project>
